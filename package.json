{
  "name": "storageflow",
  "version": "1.1.0",
  "description": "Premium Desktop File Manager",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 vite\" \"cross-env NODE_ENV=development electronmon .\"",
    "build": "vite build && electron-builder",
    "electron:build": "vite build && electron-builder"
  },
  "keywords": [],
  "author": "StorageFlow",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.storageflow.app",
    "productName": "StorageFlow 2.0",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["portable", "nsis"],
      "signAndEditExecutable": false
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  },
  "allowScripts": {
    "electron@29.4.6": true,
    "esbuild@0.21.5": true
  }
}
